<UserControl x:Class="Makdon.FindReplaceBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyboardNavigation.TabNavigation="Local"
             PreviewKeyDown="Bar_PreviewKeyDown">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1" Padding="8,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Ganti: buka/tutup baris pengganti -->
            <ToggleButton x:Name="ReplaceToggle" Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" Margin="0,1,6,0"
                          Style="{StaticResource IconToggleButton}" MinWidth="24" Padding="4,0"
                          ToolTip="Tampilkan penggantian (Ctrl+H)" AutomationProperties.Name="Tampilkan penggantian"
                          Checked="ReplaceToggle_Changed" Unchecked="ReplaceToggle_Changed">
                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" />
            </ToggleButton>

            <!-- Baris cari -->
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="140" MaxWidth="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FindBox" Grid.Column="0" TextChanged="FindBox_TextChanged"
                         AutomationProperties.Name="Cari" ToolTip="Cari (Enter = berikutnya, Shift+Enter = sebelumnya)" />
                <ToggleButton x:Name="MatchCaseToggle" Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource IconToggleButton}"
                              ToolTip="Huruf besar-kecil sama" AutomationProperties.Name="Huruf besar-kecil sama"
                              Checked="Options_Changed" Unchecked="Options_Changed">
                    <TextBlock Text="Aa" FontWeight="SemiBold" />
                </ToggleButton>
                <ToggleButton x:Name="RegexToggle" Grid.Column="2" Style="{StaticResource IconToggleButton}"
                              ToolTip="Ekspresi reguler" AutomationProperties.Name="Ekspresi reguler"
                              Checked="Options_Changed" Unchecked="Options_Changed">
                    <TextBlock Text=".*" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" />
                </ToggleButton>
                <Button Grid.Column="3" Margin="6,0,0,0" Style="{StaticResource IconButton}" Click="Previous_Click"
                        ToolTip="Sebelumnya (Shift+F3)" AutomationProperties.Name="Hasil sebelumnya">
                    <TextBlock Text="&#xE70E;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                </Button>
                <Button Grid.Column="4" Style="{StaticResource IconButton}" Click="Next_Click"
                        ToolTip="Berikutnya (F3)" AutomationProperties.Name="Hasil berikutnya">
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                </Button>
                <TextBlock x:Name="CountText" Grid.Column="5" MinWidth="96" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" AutomationProperties.LiveSetting="Polite" />
            </Grid>

            <!-- Tutup -->
            <Button Grid.Row="0" Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource IconButton}" Click="Close_Click"
                    ToolTip="Tutup (Esc)" AutomationProperties.Name="Tutup panel cari">
                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11" />
            </Button>

            <!-- Baris ganti -->
            <StackPanel x:Name="ReplaceRow" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                <TextBox x:Name="ReplaceBox" Width="250" AutomationProperties.Name="Ganti dengan"
                         ToolTip="Ganti dengan (Enter = ganti)" KeyDown="ReplaceBox_KeyDown" />
                <Button Margin="6,0,0,0" Padding="12,3" Click="Replace_Click" Content="Ganti"
                        ToolTip="Ganti hasil terpilih lalu lanjut" AutomationProperties.Name="Ganti" />
                <Button Margin="6,0,0,0" Padding="12,3" Click="ReplaceAll_Click" Content="Ganti Semua"
                        ToolTip="Ganti semua hasil (satu langkah Undo)" AutomationProperties.Name="Ganti semua" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
