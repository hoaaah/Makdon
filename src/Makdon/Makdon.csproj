<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Makdon</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Makdon</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!--
    Publish self-contained lewat profil win-x64 (Properties/PublishProfiles); lihat docs/DISTRIBUTION.md.
    RuntimeIdentifier sengaja tidak dipaksa di sini agar build/test biasa tetap netral.
  -->
  <PropertyGroup>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!--
    .NET 10 menambah pembatasan batas paket XPS: font halaman XPS hanya boleh dimuat dari paket yang sama. Untuk paket XPS
    di memori (Pratinjau Cetak, PreviewBuild) pemeriksaan itu juga menolak font milik paket sendiri, sehingga setiap halaman
    bertekst gagal dimuat dan pratinjau selalu gagal. Makdon hanya membaca XPS buatannya sendiri, jadi pembatasan dimatikan.
    Harus lewat runtimeconfig (bukan AppContext.SetSwitch di kode): WPF meng-cache switch ini saat gambar pertama dimuat.
    Test memasang switch yang sama (Makdon.Tests.csproj) dan memeriksa bahwa runtimeconfig Makdon memuatnya.
  -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.DisableXpsPackageBoundaryRestriction" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Markdig.Wpf" Version="0.5.0.1" />
  </ItemGroup>

</Project>
