<?xml version="1.0" encoding="utf-8"?>
<!--
  Profil publish rilis: self-contained, folder (bukan single-file), tanpa trimming dan tanpa ReadyToRun.
  Dipakai bersama oleh build lokal (scripts/build-release.ps1) dan CI (.github/workflows/release.yml).
    dotnet publish src/Makdon -p:PublishProfile=win-x64
  Keluaran: src\Makdon\bin\Release\net10.0-windows\win-x64\publish\
  Alasan folder (bukan single-file): lihat docs/DISTRIBUTION.md bagian 2.1.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
