<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema Gelap. Kunci harus sama persis dengan Light.xaml. Rasio kontras teks terhadap latar >= 4.5:1. -->

    <!-- Kerangka aplikasi -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1B1C1F" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#25262A" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#303238" />
    <SolidColorBrush x:Key="BorderBrush" Color="#383A40" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#4F525A" />

    <!-- Teks -->
    <SolidColorBrush x:Key="TextBrush" Color="#E6E8EB" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A4AAB4" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#6C727C" />

    <!-- Aksen & status -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6AA5FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8DBBFF" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#0A1B33" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#263A57" />
    <SolidColorBrush x:Key="FocusBrush" Color="#8DBBFF" />
    <SolidColorBrush x:Key="DirtyBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />

    <!-- Interaksi -->
    <SolidColorBrush x:Key="HoverBrush" Color="#33353B" />
    <SolidColorBrush x:Key="PressedBrush" Color="#3D4047" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4B4E56" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#6A6E78" />

    <!-- Editor -->
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#1E1F23" />
    <SolidColorBrush x:Key="EditorForegroundBrush" Color="#D9DCE1" />
    <SolidColorBrush x:Key="LineNumberBrush" Color="#7C838E" />
    <SolidColorBrush x:Key="CurrentLineBrush" Color="#26282D" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#2F4F7E" />
    <SolidColorBrush x:Key="SearchMatchBrush" Color="#5E4B12" />
    <SolidColorBrush x:Key="SearchCurrentBrush" Color="#8A5A00" />

    <!-- Warna sintaks Markdown (dipakai kode untuk HighlightingColor) -->
    <SolidColorBrush x:Key="SyntaxHeadingBrush" Color="#7DB8FF" />
    <SolidColorBrush x:Key="SyntaxQuoteBrush" Color="#9CA6B4" />
    <SolidColorBrush x:Key="SyntaxLinkBrush" Color="#79C0FF" />
    <SolidColorBrush x:Key="SyntaxImageBrush" Color="#7EE0A0" />
    <SolidColorBrush x:Key="SyntaxCodeBrush" Color="#FFB86C" />
    <SolidColorBrush x:Key="SyntaxLineBreakBrush" Color="#3A3D44" />

    <!-- Pratinjau -->
    <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="#1E1F23" />
    <SolidColorBrush x:Key="PreviewTextBrush" Color="#DADDE2" />
    <SolidColorBrush x:Key="PreviewMutedBrush" Color="#A4AAB4" />
    <SolidColorBrush x:Key="PreviewLinkBrush" Color="#79B8FF" />
    <SolidColorBrush x:Key="PreviewCodeBackgroundBrush" Color="#2B2D33" />
    <SolidColorBrush x:Key="PreviewCodeTextBrush" Color="#E3E5E9" />
    <SolidColorBrush x:Key="PreviewQuoteBorderBrush" Color="#6AA5FF" />
    <SolidColorBrush x:Key="PreviewRuleBrush" Color="#3D4047" />
    <SolidColorBrush x:Key="PreviewTableBorderBrush" Color="#41444B" />
    <SolidColorBrush x:Key="PreviewTableHeaderBrush" Color="#2B2D33" />
    <SolidColorBrush x:Key="PreviewMarkBrush" Color="#6B5A14" />
</ResourceDictionary>
