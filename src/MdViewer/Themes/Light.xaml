<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema Terang. Kunci harus sama persis dengan Dark.xaml. Rasio kontras teks terhadap latar >= 4.5:1. -->

    <!-- Kerangka aplikasi -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#ECEEF2" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E1E4E8" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#BFC5CD" />

    <!-- Teks -->
    <SolidColorBrush x:Key="TextBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#586069" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#8C949E" />

    <!-- Aksen & status -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#E3EDFE" />
    <SolidColorBrush x:Key="FocusBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="DirtyBrush" Color="#C2570C" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B31" />

    <!-- Interaksi -->
    <SolidColorBrush x:Key="HoverBrush" Color="#E9ECF0" />
    <SolidColorBrush x:Key="PressedBrush" Color="#DCE0E6" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C3C8D0" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#9AA1AB" />

    <!-- Editor -->
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="EditorForegroundBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="LineNumberBrush" Color="#6A737D" />
    <SolidColorBrush x:Key="CurrentLineBrush" Color="#F4F6F9" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#B9D3FB" />
    <SolidColorBrush x:Key="SearchMatchBrush" Color="#FFE69A" />
    <SolidColorBrush x:Key="SearchCurrentBrush" Color="#FFB84D" />

    <!-- Warna sintaks Markdown (dipakai kode untuk HighlightingColor) -->
    <SolidColorBrush x:Key="SyntaxHeadingBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="SyntaxQuoteBrush" Color="#57606A" />
    <SolidColorBrush x:Key="SyntaxLinkBrush" Color="#0A58CA" />
    <SolidColorBrush x:Key="SyntaxImageBrush" Color="#1A7F37" />
    <SolidColorBrush x:Key="SyntaxCodeBrush" Color="#B35100" />
    <SolidColorBrush x:Key="SyntaxLineBreakBrush" Color="#E3E6EA" />

    <!-- Pratinjau -->
    <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PreviewTextBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="PreviewMutedBrush" Color="#586069" />
    <SolidColorBrush x:Key="PreviewLinkBrush" Color="#0A58CA" />
    <SolidColorBrush x:Key="PreviewCodeBackgroundBrush" Color="#F1F3F6" />
    <SolidColorBrush x:Key="PreviewCodeTextBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="PreviewQuoteBorderBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="PreviewRuleBrush" Color="#D8DCE2" />
    <SolidColorBrush x:Key="PreviewTableBorderBrush" Color="#D8DCE2" />
    <SolidColorBrush x:Key="PreviewTableHeaderBrush" Color="#F1F3F6" />
    <SolidColorBrush x:Key="PreviewMarkBrush" Color="#FFE69A" />
</ResourceDictionary>
