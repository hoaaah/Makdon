<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf">
    <!--
        Menimpa style bawaan Markdig.Wpf (Styles.*) untuk FlowDocument pratinjau. Warna memakai DynamicResource
        sehingga mengikuti tema; saat mencetak, FlowDocument diberi Resources tema Terang sendiri.
        Lebar baca maksimum (±860 px, di tengah) diatur lewat PagePadding oleh DocumentView.UpdateReadingPadding.
    -->

    <FontFamily x:Key="PreviewFont">Segoe UI Variable Text, Segoe UI, Calibri</FontFamily>
    <FontFamily x:Key="PreviewMonoFont">Cascadia Mono, Cascadia Code, Consolas, Courier New</FontFamily>

    <Style x:Key="{x:Static markdig:Styles.DocumentStyleKey}" TargetType="FlowDocument">
        <Setter Property="FontFamily" Value="{StaticResource PreviewFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="Foreground" Value="{DynamicResource PreviewTextBrush}" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="PagePadding" Value="40,28,40,56" />
        <Setter Property="IsOptimalParagraphEnabled" Value="False" />
    </Style>

    <Style x:Key="{x:Static markdig:Styles.ParagraphStyleKey}" TargetType="Paragraph">
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <!-- Hierarki heading -->
    <Style x:Key="{x:Static markdig:Styles.Heading1StyleKey}" TargetType="Paragraph">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="44" />
        <Setter Property="Foreground" Value="{DynamicResource PreviewTextBrush}" />
        <Setter Property="Margin" Value="0,12,0,18" />
        <Setter Property="Padding" Value="0,0,0,10" />
        <Setter Property="BorderBrush" Value="{DynamicResource PreviewRuleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style x:Key="{x:Static markdig:Styles.Heading2StyleKey}" TargetType="Paragraph">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="34" />
        <Setter Property="Foreground" Value="{DynamicResource PreviewTextBrush}" />
        <Setter Property="Margin" Value="0,28,0,14" />
        <Setter Property="Padding" Value="0,0,0,8" />
        <Setter Property="BorderBrush" Value="{DynamicResource PreviewRuleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style x:Key="{x:Static markdig:Styles.Heading3StyleKey}" TargetType="Paragraph">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="29" />
        <Setter Property="Foreground" Value="{DynamicResource PreviewTextBrush}" />
        <Setter Property="Margin" Value="0,24,0,10" />
    </Style>
    <Style x:Key="{x:Static markdig:Styles.Heading4StyleKey}" TargetType="Paragraph">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="Foreground" Value="{DynamicResource PreviewTextBrush}" />
        <Setter Property="Margin" Value="0,20,0,8" />
    </Style>
    <Style x:Key="{x:Static markdig:Styles.Heading5StyleKey}" TargetType="Paragraph">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PreviewTextBrush}" />
        <Setter Property="Margin" Value="0,18,0,6" />
    </Style>
    <Style x:Key="{x:Static markdig:Styles.Heading6StyleKey}" TargetType="Paragraph">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PreviewMutedBrush}" />
        <Setter Property="Margin" Value="0,16,0,6" />
    </Style>

    <!-- Kode -->
    <Style x:Key="{x:Static markdig:Styles.CodeStyleKey}" TargetType="Run">
        <Setter Property="FontFamily" Value="{StaticResource PreviewMonoFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="{DynamicResource PreviewCodeBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PreviewCodeTextBrush}" />
    </Style>
    <Style x:Key="{x:Static markdig:Styles.CodeBlockStyleKey}" TargetType="Paragraph">
        <Setter Property="FontFamily" Value="{StaticResource PreviewMonoFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Background" Value="{DynamicResource PreviewCodeBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PreviewCodeTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PreviewRuleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,4,0,18" />
    </Style>

    <!-- Kutipan dengan garis aksen -->
    <Style x:Key="{x:Static markdig:Styles.QuoteBlockStyleKey}" TargetType="Section">
        <Setter Property="BorderBrush" Value="{DynamicResource PreviewQuoteBorderBrush}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource PreviewMutedBrush}" />
        <Setter Property="Padding" Value="16,2,8,2" />
        <Setter Property="Margin" Value="0,4,0,16" />
    </Style>

    <!-- Garis pemisah tipis -->
    <Style x:Key="{x:Static markdig:Styles.ThematicBreakStyleKey}" TargetType="Line">
        <Setter Property="Stretch" Value="Fill" />
        <Setter Property="Stroke" Value="{DynamicResource PreviewRuleBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Margin" Value="0,20" />
    </Style>

    <!-- Tabel bergaris halus -->
    <Style x:Key="{x:Static markdig:Styles.TableStyleKey}" TargetType="Table">
        <Setter Property="CellSpacing" Value="0" />
        <Setter Property="BorderBrush" Value="{DynamicResource PreviewTableBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Margin" Value="0,6,0,18" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="{x:Static markdig:Styles.TableCellStyleKey}" TargetType="TableCell">
        <Setter Property="BorderBrush" Value="{DynamicResource PreviewTableBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,1,0,0" />
        <Setter Property="Padding" Value="12,7" />
    </Style>
    <Style x:Key="{x:Static markdig:Styles.TableHeaderStyleKey}" TargetType="TableRow">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource PreviewTableHeaderBrush}" />
    </Style>

    <!-- Tautan & penanda -->
    <Style x:Key="{x:Static markdig:Styles.HyperlinkStyleKey}" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource PreviewLinkBrush}" />
        <Setter Property="TextDecorations" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="{x:Static markdig:Styles.MarkedStyleKey}" TargetType="Span">
        <Setter Property="Background" Value="{DynamicResource PreviewMarkBrush}" />
    </Style>

    <!-- Kotak centang daftar tugas memakai gaya CheckBox tema -->
    <Style x:Key="{x:Static markdig:Styles.TaskListStyleKey}" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="0,0,0,-2" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <!-- Daftar -->
    <Style TargetType="{x:Type List}">
        <Setter Property="Margin" Value="28,2,0,14" />
        <Setter Property="Padding" Value="0" />
    </Style>
</ResourceDictionary>
